# ─── Database ────────────────────────────────────────────────
# Local development (docker compose up -d db from the repo root):
DATABASE_URL="postgresql://urpmp:urpmp_dev_password@localhost:5544/urpmp?schema=public"

# Render managed PostgreSQL: copy the "External Database URL" from the Render dashboard
# (use the "Internal Database URL" when the backend itself runs on Render) and append
# ?sslmode=require. NEVER commit the real value — set it in the Render environment or a local .env.
# DATABASE_URL="postgresql://<user>:<password>@<host>.oregon-postgres.render.com/<db>?sslmode=require"

# ─── API server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# ─── Auth ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Min 32 chars. Use a DIFFERENT value per environment. Never commit the real one.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Inactivity window: a token expires this many minutes after the user's last request.
JWT_INACTIVITY_MINUTES=30
BCRYPT_ROUNDS=12
# NFR-013: lock the account after N failed logins within the window.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_MINUTES=10
LOCKOUT_MINUTES=15
RATE_LIMIT_ENABLED=true
# Required in production. Sent as the `x-bootstrap-secret` header to POST /auth/bootstrap-owner,
# so only whoever controls the deployment can create the first Administrator.
BOOTSTRAP_OWNER_SECRET=

# ─── Tests ───────────────────────────────────────────────────
# Tests only run against a LOCAL database (they refuse any other host). Created automatically.
# TEST_DATABASE_URL="postgresql://urpmp:urpmp_dev_password@localhost:5544/urpmp_test?schema=public"

# ─── AI / RAG embeddings (docs/AI_RAG.md) ─────────────────────
# mock = deterministic offline embeddings (dev/test only, NOT semantically real).
# openai = any OpenAI-compatible /v1/embeddings API. The DB column is vector(1536): the model must output 1536 dims.
EMBEDDING_PROVIDER=mock
# Required only when EMBEDDING_PROVIDER=openai (the server refuses to start without it). Never commit it.
EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_MS=30000

# ─── AI assistant (POST /projects/:id/ask) ───────────────────
# `mock` answers by quoting the retrieved passages (no API key needed; dev/test only).
LLM_PROVIDER=mock
# LLM_API_KEY=
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=10000
# Best-chunk cosine similarity below this returns "no relevant information found" (AIR-004). Tune it per provider.
# AI_MIN_SIMILARITY=0.15
# AI_TOP_K=5
