# Base URL of the backend API (no trailing slash). The dev API listens on 4000 in this project.
VITE_API_URL=http://localhost:4000

# true = serve auth endpoints from src/mocks/ instead of the network and show a "MOCK API" banner.
# Keep false: the real /auth/login and /auth/me exist.
VITE_USE_MOCKS=false
