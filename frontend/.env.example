# Base URL of the backend API (no trailing slash). Read at BUILD time.
VITE_API_URL=http://localhost:4000

# true = simulate ONLY the documents endpoints (GET/POST /projects/:id/documents and download) in memory,
# because the documents backend may not be deployed yet. Shows a visible "API SIMULADA" banner.
# Everything else (login, projects, collaborators) always uses the real API. Keep false by default.
VITE_USE_MOCKS=false
